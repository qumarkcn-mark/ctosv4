# CT-OS V4.0 交易教练 — 环境变量

# 服务器
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 数据库
DB_PATH=./data/ctos.db

# 微信小程序
WX_APP_ID=
WX_APP_SECRET=

# LLM (语音文本提取)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
AI_NATIVE_RADAR_ENABLED=true
AI_NATIVE_RADAR_GATE_ENABLED=true
AI_NATIVE_RADAR_MODEL=deepseek-v4-pro
# AI Native 默认启用 DeepSeek thinking，可在后台用户设置覆盖
AI_NATIVE_RADAR_THINKING_ENABLED=true
AI_NATIVE_RADAR_REASONING_EFFORT=high
AI_NATIVE_RADAR_MAX_TOKENS=4096
AI_NATIVE_RADAR_LLM_TIMEOUT=90

# 推送通知 (备用)
DINGTALK_WEBHOOK=

# Scanner 管理接口保护（生产建议设置）
SCANNER_ADMIN_TOKEN=
