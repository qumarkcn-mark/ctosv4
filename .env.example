# CT-OS V4.0 交易教练 — 环境变量

# 服务器
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 数据库
DB_PATH=./data/ctos.db

# 微信小程序
WX_APP_ID=
WX_APP_SECRET=

# LLM (语音文本提取)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# Qwen / Alibaba Cloud Model Studio (事实抽取：交易文本 + 截图 OCR)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ALLOWED_BASE_URLS=https://dashscope.aliyuncs.com/compatible-mode/v1,https://dashscope-intl.aliyuncs.com/compatible-mode/v1,https://dashscope-us.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen-plus
QWEN_TRADE_PARSE_MODEL=qwen-flash
QWEN_SCREENSHOT_OCR_MODEL=qwen-vl-ocr-latest

AI_NATIVE_RADAR_ENABLED=true
AI_NATIVE_RADAR_GATE_ENABLED=true
AI_NATIVE_RADAR_MODEL=deepseek-v4-pro
# AI Native 默认启用 DeepSeek thinking，可在后台用户设置覆盖
AI_NATIVE_RADAR_THINKING_ENABLED=true
AI_NATIVE_RADAR_REASONING_EFFORT=high
AI_NATIVE_RADAR_MAX_TOKENS=4096
AI_NATIVE_RADAR_LLM_TIMEOUT=90
# Fusion/AI Chan 是前台和 CLI 消费链路，默认关闭 thinking 以避免两段式推演超时。
AI_NATIVE_FUSION_MODEL=deepseek-v4-pro
AI_NATIVE_FUSION_THINKING_ENABLED=false
AI_NATIVE_FUSION_LLM_TIMEOUT=45

# Structure snapshot job queue
# 默认保持旧同步路径；确认快照和 worker 稳定后再开启前两项。
STRUCTURE_SNAPSHOT_FIRST_ENABLED=true
STRUCTURE_WORKER_ENABLED=false
STRUCTURE_SYNC_IF_MISSING=false
STRUCTURE_WORKER_INTERVAL=2
STRUCTURE_JOB_TIMEOUT_SECONDS=600

# 推送通知 (备用)
DINGTALK_WEBHOOK=

# Scanner 管理接口保护（生产建议设置）
SCANNER_ADMIN_TOKEN=
