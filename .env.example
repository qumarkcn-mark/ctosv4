# CT-OS V4.0 交易教练 — 环境变量

# 服务器
HOST=0.0.0.0
PORT=8000
DEBUG=false
DEV_AUTH_FALLBACK=false
JWT_SECRET=replace-with-a-long-random-production-secret

# 数据库
DB_PATH=./data/ctos.db

# 微信小程序
WX_APP_ID=
WX_APP_SECRET=

# LLM (语音文本提取)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# Qwen / Alibaba Cloud Model Studio (事实抽取：交易文本 + 截图 OCR)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ALLOWED_BASE_URLS=https://dashscope.aliyuncs.com/compatible-mode/v1,https://dashscope-intl.aliyuncs.com/compatible-mode/v1,https://dashscope-us.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen-plus
QWEN_TRADE_PARSE_MODEL=qwen-flash
QWEN_SCREENSHOT_OCR_MODEL=qwen-vl-ocr-latest

AI_NATIVE_MODEL=deepseek-v4-pro
AI_NATIVE_THINKING_ENABLED=true
AI_NATIVE_REASONING_EFFORT=high
AI_NATIVE_MAX_TOKENS=4096
AI_NATIVE_LLM_TIMEOUT=150

# CZSC structure snapshot job queue
STRUCTURE_SNAPSHOT_FIRST_ENABLED=true
STRUCTURE_WORKER_ENABLED=true
STRUCTURE_SYNC_IF_MISSING=false
STRUCTURE_WORKER_INTERVAL=2
STRUCTURE_JOB_TIMEOUT_SECONDS=600
AI_STRUCTURE_OUTCOME_WORKER_INTERVAL=60
AI_UNIFIED_REASONING_AFTER_KLINE_SYNC_ENABLED=true
AI_UNIFIED_REASONING_AFTER_KLINE_SYNC_SYMBOLS_PER_USER=30

# 推送通知 (备用)
DINGTALK_WEBHOOK=
