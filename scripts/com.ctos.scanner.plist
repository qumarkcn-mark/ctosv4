<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ctos.scanner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/markqu/Desktop/ct-os-v4/venv/bin/python</string>
        <string>-m</string>
        <string>server.workers.scanner</string>
    </array>

    <!-- 每天 18:30 运行（TDX 18:05 同步完成后留 25 分钟余量）-->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/markqu/Desktop/ct-os-v4</string>

    <key>StandardOutPath</key>
    <string>/Users/markqu/Desktop/ct-os-v4/logs/scanner.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/markqu/Desktop/ct-os-v4/logs/scanner_err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/markqu/Desktop/ct-os-v4</string>
    </dict>
</dict>
</plist>
