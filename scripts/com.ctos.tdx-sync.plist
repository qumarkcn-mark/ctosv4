<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ctos.tdx-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/markqu/Desktop/ct-os-v4/scripts/tdx_sync.sh</string>
    </array>

    <!-- 每天 18:05 运行（收盘后，TDX 数据已刷新）-->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/markqu/Desktop/ct-os-v4/logs/tdx_sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/markqu/Desktop/ct-os-v4/logs/tdx_sync_err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
