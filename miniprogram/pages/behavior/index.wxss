.container { padding: 40rpx; min-height: 100vh; }
.header { text-align: center; margin-bottom: 40rpx; }
.title { font-size: 36rpx; font-weight: 600; color: var(--text-primary); }
.loading { text-align: center; color: var(--text-secondary); padding: 200rpx 0; font-size: 28rpx; }

/* ── 评分圆环 ── */
.score-ring { display: flex; justify-content: center; margin-bottom: 50rpx; }
.ring-bg {
  width: 260rpx; height: 260rpx; border-radius: 50%;
  background: conic-gradient(rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.08) 100%);
  display: flex; align-items: center; justify-content: center;
  border: 6rpx solid rgba(255,255,255,0.1);
}
.ring-value {
  width: 220rpx; height: 220rpx; border-radius: 50%;
  background-color: var(--card-bg);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border: 4rpx solid transparent;
}
.ring-value.good { border-color: rgba(34,197,94,0.5); }
.ring-value.warn { border-color: rgba(234,179,8,0.5); }
.ring-value.bad { border-color: rgba(239,68,68,0.5); }
.score-number { font-size: 72rpx; font-weight: 800; color: var(--text-primary); line-height: 1; }
.score-label { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }

/* ── 雷达图 ── */
.radar-section { margin-bottom: 50rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); display: block; margin-bottom: 24rpx; }
.radar-wrap { position: relative; width: 400rpx; height: 400rpx; margin: 0 auto; }
.radar-svg { width: 100%; height: 100%; }
.radar-labels { position: absolute; inset: 0; }
.rl { position: absolute; font-size: 22rpx; color: var(--text-secondary); }
.rl-top { top: 0; left: 50%; transform: translateX(-50%); }
.rl-tr { top: 22%; right: 0; }
.rl-br { bottom: 22%; right: 0; }
.rl-bottom { bottom: 0; left: 50%; transform: translateX(-50%); }
.rl-bl { bottom: 22%; left: 0; }
.rl-tl { top: 22%; left: 0; }

/* ── 诊断卡片 ── */
.diagnosis-section { margin-bottom: 40rpx; }
.diag-card {
  padding: 28rpx; border-radius: 16rpx; margin-bottom: 20rpx;
  background-color: var(--card-bg); border-left: 8rpx solid #555;
}
.diag-card.critical { border-left-color: #EF4444; }
.diag-card.warning { border-left-color: #EAB308; }
.diag-card.success { border-left-color: #22C55E; }
.diag-card.info { border-left-color: #3B82F6; }

.diag-header { display: flex; align-items: center; margin-bottom: 12rpx; }
.diag-icon { font-size: 28rpx; margin-right: 12rpx; }
.diag-title { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.diag-detail { font-size: 24rpx; color: var(--text-secondary); line-height: 1.6; }
