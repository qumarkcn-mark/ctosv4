.container {
  min-height: 100vh;
  padding: 32rpx;
  background: #0b0c10;
  color: rgba(255, 255, 255, 0.9);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.94);
  line-height: 1.2;
}

.code {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.refresh-btn {
  min-width: 132rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  border: 1px solid rgba(255, 255, 255, 0.16);
  background: #18181e;
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 28rpx;
}

.error-panel,
.status-panel,
.metric-card,
.memory-panel,
.guardrail-panel {
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  background: #111115;
}

.error-panel {
  padding: 28rpx;
  color: #f59e0b;
  border-color: rgba(245, 158, 11, 0.32);
  background: rgba(245, 158, 11, 0.1);
}

.status-panel {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid rgba(255, 255, 255, 0.18);
}

.status-panel.ready {
  border-left-color: #22c55e;
}

.status-panel.warn,
.status-panel.working {
  border-left-color: #f59e0b;
}

.status-panel.error {
  border-left-color: #dc2626;
}

.status-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.status-label,
.metric-label,
.section-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.52);
}

.status-value {
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.94);
}

.status-copy,
.memory-copy,
.guardrail-copy {
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.62);
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  min-height: 126rpx;
  padding: 22rpx;
}

.metric-label {
  display: block;
  margin-bottom: 14rpx;
}

.metric-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
}

.metric-value.warn {
  color: #f59e0b;
}

.memory-panel,
.guardrail-panel {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  margin-bottom: 14rpx;
  font-weight: 600;
}
