.container {
  padding: 30rpx;
}
.header {
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}
.subscribe-btn {
  background: rgba(234, 179, 8, 0.1);
  border: 1px solid #eab308;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}
.subscribe-btn text {
  color: #eab308;
  font-size: 24rpx;
  font-weight: bold;
}
.overview-cards {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}
.stat-card {
  flex: 1;
  background: #1f2833;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}
.stat-card:last-child {
  margin-right: 0;
}
.health-card {
  border-left: 6rpx solid #eab308;
}
.stat-label {
  display: block;
  font-size: 24rpx;
  color: #8b92a5;
  margin-bottom: 10rpx;
}
.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
}
.up { color: #66fcf1; }
.down { color: #22c55e; } /* A股设定，跌为绿 */

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.position-item {
  background: #1f2833;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.p-header {
  margin-bottom: 16rpx;
}
.p-name {
  font-size: 30rpx;
  color: #fff;
}
.p-code {
  font-size: 24rpx;
  color: #8b92a5;
  margin-left: 10rpx;
}
.p-stats {
  display: flex;
  margin-bottom: 16rpx;
}
.p-stat {
  flex: 1;
}
.p-stat .l {
  font-size: 24rpx;
  color: #8b92a5;
  margin-right: 10rpx;
}
.p-stat .v {
  font-size: 28rpx;
}
.p-watchdog {
  background: rgba(234, 179, 8, 0.05);
  border-left: 4rpx solid #eab308;
  padding: 12rpx;
  border-radius: 8rpx;
}
.wd-label {
  font-size: 24rpx;
  color: #eab308;
}
.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #8b92a5;
}
